# Cloudflare Pages response headers.
# Images rarely change, so browsers keep them for 30 days and repeat visits load faster.
# Scripts, styles, data and pages keep the default (checked on every visit), so a new
# deploy reaches everyone at once and old and new scripts never mix.

/assets/img/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=()
